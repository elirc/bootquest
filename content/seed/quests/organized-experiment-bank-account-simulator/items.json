   "kind": "flashcard",
   "shape": "hand-authored",
   "label": "f02-escape-format",
   "front": "How does FileStorage keep a | or a newline inside a text field from breaking a line?",
   "back": "escape writes \\ as \\\\, | as \\|, and newlines as \\n or \\r before joining fields with |. splitLine walks the line character by character: a backslash means the next character is literal (n and r turn back into line breaks), and only an unescaped | ends a field.",
   "observation": "read-derived",
   "aiTag": false
  },
