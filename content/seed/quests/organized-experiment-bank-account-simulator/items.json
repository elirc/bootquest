   "kind": "flashcard",
   "shape": "hand-authored",
   "label": "f01-bigdecimal",
   "front": "Why does the simulator store money as BigDecimal rather than double?",
   "back": "double is binary floating point and cannot hold most decimal fractions exactly, so sums drift (0.1 + 0.2 gives 0.30000000000000004). BigDecimal keeps exact decimal digits, and the service fixes every amount to two decimal places before using it.",
   "observation": "read-derived",
   "aiTag": false
  },
