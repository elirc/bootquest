   "kind": "flashcard",
   "shape": "hand-authored",
   "label": "f04-guards-outside-tx",
   "front": "Why is it a problem that recordDecision and disburseApplication run their guards before prisma.$transaction?",
   "back": "The guard reads state outside the transaction, so a concurrent write can change the facts between the check and the update. The transaction makes the writes atomic, but not the decision to allow them; there is no optimistic locking on stateVersion.",
   "observation": "read-derived",
   "aiTag": false
  },
