   "label": "f03-callback-ref",
   "front": "React rule for a callback that outlives the render that created it?",
   "back": "Read changing values from a ref, not from its closure (SignalR/WebSocket handlers, timers, window listeners). Listing them as effect deps recreates the resource too often; [] without a ref acts on mount-time values forever.",
   "observation": "read-derived",
   "aiTag": false
