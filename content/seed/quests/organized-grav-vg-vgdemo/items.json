   "kind": "flashcard",
   "shape": "hand-authored",
   "label": "f02-singleton-store",
   "front": "What goes wrong with the in-memory store registered as a singleton?",
   "back": "One instance of plain List<T>s is shared by concurrent requests, so simultaneous writes can corrupt a list. Calculate does RemoveAll then AddRange with no atomicity: a reader in between sees a calculated run with no items, and an exception in between loses them.",
   "observation": "read-derived",
   "aiTag": false
  },
