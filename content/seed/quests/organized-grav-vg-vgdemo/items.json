   "label": "f03-comment-out-migration",
   "front": "What is wrong with how this repo migrated from TypeScript to .NET?",
   "back": "The original app was kept by prefixing every line of 87 files with //, with no git history at all. Version control is what makes old code recoverable; commented-out code rots, confuses search and review, and still has to be read.",
   "observation": "read-derived",
   "aiTag": false
  },
