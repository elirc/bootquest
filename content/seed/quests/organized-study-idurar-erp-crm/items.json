   "shape": "hand-authored",
   "label": "f03-credit-invariant",
   "front": "What invariant does Invoice.credit cache, and how can it break?",
   "back": "credit === sum of the non-removed payments' amounts (and paymentStatus is derived from it). It is maintained by separate writes with no transaction, so a crash between the payment insert and the invoice update, or between invoice and payment soft-deletes, silently breaks it.",
   "observation": "read-derived",
   "aiTag": false
