   "prompt": "Page and Block carry a Guid Version. What happens to a write that omits ExpectedVersion?",
   "choices": [
    {
     "text": "It is rejected with 428 Precondition Required",
     "evidence": []
    },
    {
     "text": "It is queued until the client fetches a fresh version",
     "evidence": []
    },
    {
     "text": "It is rejected with 409, since the version is required",
     "evidence": []
    },
    {
     "text": "The concurrency check is skipped, for backward compatibility",
     "evidence": [
