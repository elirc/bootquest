   "kind": "flashcard",
   "shape": "hand-authored",
   "label": "f02-public-slug-revoke",
   "front": "How do public page links work, and how is one revoked?",
   "back": "A Public page gets a random PublicSlug readable anonymously at GET /api/public/pages/{slug}. Changing visibility away from Public clears the slug, revoking the link immediately; the slug has a filtered unique index (unique only where non-null).",
   "observation": "read-derived",
   "aiTag": false
