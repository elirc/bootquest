   "check": {
    "type": "quiz",
    "itemKey": "seed:quests:folio-app/quiz/0178bacb60cb7047",
    "grading": "choice",
    "answerKey": 3,
    "choices": [
     "It is rejected with 428 Precondition Required",
     "It is queued until the client fetches a fresh version",
     "It is rejected with 409, since the version is required",
     "The concurrency check is skipped, for backward compatibility"
    ]
   },
   "explanation": "A mismatched ExpectedVersion gives 409; the Guid rotates on every successful write because SQLite has no native rowversion (ADR 0009)."
