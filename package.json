{
  "name": "bootquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BootQuest: single-user, local-first gamified upskilling platform",
  "workspaces": [
    "shared",
    "server",
    "client",
    "cli",
    "tools/seed"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "serve": "npm run serve -w @bootquest/server",
    "smoke:api": "node --import tsx server/scripts/smoke-api.mjs",
    "test:csharp": "npm run test:csharp -w @bootquest/server",
    "build:client": "npm run build -w @bootquest/client",
    "seed:import:bootforge": "node --import tsx tools/seed/src/bootforge/cli.ts",
    "seed:import:csbootcamp": "node --import tsx tools/seed/src/csbootcamp/cli.ts",
    "seed:validate": "node --import tsx tools/seed/src/validate/cli.ts"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
