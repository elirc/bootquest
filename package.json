{
  "name": "bootquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BootQuest: single-user, local-first gamified upskilling platform",
  "workspaces": [
    "shared",
    "server",
    "client",
    "cli",
    "tools/seed"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "serve": "npm run serve -w @bootquest/server",
    "reset": "node --import tsx server/src/db/reset-cli.ts",
    "smoke:api": "node --import tsx server/scripts/smoke-api.mjs",
    "sweep:ntf": "node server/scripts/sweep-ntf.mjs",
    "test:csharp": "npm run test:csharp -w @bootquest/server",
    "build:client": "npm run build -w @bootquest/client",
    "test:mutate-fixture": "node --import tsx cli/scripts/mutate-fixture.ts",
    "demo:promotion": "node --import tsx server/scripts/promotion-e2e.mjs",
    "demo:campaign": "node --import tsx server/scripts/campaign-e2e.mjs",
    "seed:import:bootforge": "node --import tsx tools/seed/src/bootforge/cli.ts",
    "seed:import:csbootcamp": "node --import tsx tools/seed/src/csbootcamp/cli.ts",
    "seed:import:jstrain": "node --import tsx tools/seed/src/jstrain/cli.ts",
    "seed:validate": "node --import tsx tools/seed/src/validate/cli.ts",
    "seed:sync": "node --import tsx tools/seed/src/sync/cli.ts",
    "demo:m4": "node --import tsx tools/seed/src/sync/m4-demo.ts",
    "seed:campaign": "node --import tsx tools/seed/src/campaign/cli.ts",
    "seed:quests": "node --import tsx tools/seed/src/factory/quests/cli.ts",
    "seed:quests:drafts": "node --import tsx tools/seed/src/drafts/cli.ts",
    "seed:explainback": "node --import tsx tools/seed/src/factory/explainback/cli.ts",
    "seed:variants": "node --import tsx tools/seed/src/factory/variants/cli.ts",
    "seed:patches": "node --import tsx tools/seed/src/factory/patches/cli.ts",
    "seed:notes": "node --import tsx tools/seed/src/factory/notes/cli.ts",
    "seed:check": "node --import tsx tools/seed/src/factory/check/cli.ts",
    "restamp:all": "node --import tsx tools/seed/src/ops/cli.ts",
    "seed:lint:answers": "node --import tsx tools/seed/src/ops/answer-lint-cli.ts",
    "seed:demo:planted": "node --import tsx tools/seed/src/factory/demo/planted.ts",
    "bootquest": "node --import tsx cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
