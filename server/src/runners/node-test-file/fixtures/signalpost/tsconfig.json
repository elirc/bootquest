{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "noEmit": true, "types": ["node"], "allowJs": false
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "services/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "apps/web/.next"]
}
