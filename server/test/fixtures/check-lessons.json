{
  "units": [
    {
      "key": "fixture:http-tasks-api",
      "track": "js",
      "kind": "http-lab",
      "title": "Tasks API answers like the contract",
      "difficulty": 2,
      "competencies": ["data-http"],
      "checks": [
        {
          "spec": {
            "type": "http",
            "port": 3000,
            "requests": [
              {
                "name": "health check answers ok",
                "method": "GET",
                "path": "/health",
                "expect": { "status": 200, "jsonShape": { "object": { "ok": { "equals": true } } } }
              },
              {
                "name": "create a task",
                "method": "POST",
                "path": "/api/tasks",
                "body": { "title": "write the tests first" },
                "expect": {
                  "status": 201,
                  "headers": { "content-type": "application/json" },
                  "jsonShape": {
                    "object": {
                      "id": "integer",
                      "title": { "equals": "write the tests first" },
                      "done": { "equals": false }
                    }
                  }
                }
              },
              {
                "name": "list tasks",
                "method": "GET",
                "path": "/api/tasks",
                "expect": {
                  "status": 200,
                  "jsonShape": {
                    "object": {
                      "items": { "array": { "object": { "id": "integer", "title": "string", "done": "boolean" } }, "minItems": 1 }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "key": "fixture:repo-feature-branch",
      "track": "js",
      "kind": "repo-task",
      "title": "Ship a feature on its own branch",
      "difficulty": 2,
      "competencies": ["feature-delivery"],
      "checks": [
        {
          "spec": {
            "type": "repo",
            "predicates": [
              { "kind": "branch-exists", "name": "feature branch exists", "branch": "feat/add-tasks" },
              { "kind": "head-on-branch", "name": "you are on the feature branch", "branch": "feat/add-tasks" },
              { "kind": "file-exists-at-head", "name": "decision record committed", "path": "docs/DECISIONS.md" },
              { "kind": "clean-worktree", "name": "nothing left uncommitted" },
              { "kind": "min-commits", "name": "small commits (3+)", "n": 3 },
              {
                "kind": "commit-message-matches",
                "name": "conventional commit message",
                "pattern": "^(feat|fix|docs|test|refactor|chore)(\\([a-z0-9-]+\\))?: \\S"
              }
            ]
          }
        }
      ]
    }
  ],
  "content": {
    "fixture:http-tasks-api": {
      "instructions": "Run your tasks API locally, then `bootquest submit --port <port>`. The check sends GET /health, POST /api/tasks and GET /api/tasks."
    },
    "fixture:repo-feature-branch": {
      "instructions": "Create the feat/add-tasks branch, commit your work in small conventional commits (including docs/DECISIONS.md), then `bootquest submit --repo .`."
    }
  }
}
