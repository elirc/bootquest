{
  "name": "@bootquest/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runners": "./src/api/runners.ts",
    "./runner-csharp": "./src/api/runner-csharp.ts",
    "./runners/csharp/split": "./src/runners/csharp/csbootcamp-split.ts",
    "./runners/js": "./src/runners/js/index.ts",
    "./runners/js/language": "./src/runners/js/language.ts",
    "./grade-core": "./src/runners/js/grade-core.mjs",
    "./packs": "./src/store/packs.ts",
    "./grader-fingerprint": "./src/store/grader-fingerprint.ts",
    "./db": "./src/db/database.ts",
    "./clock": "./src/engines/clock.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ../tsconfig.json",
    "migrate": "tsx src/db/migrate-cli.ts",
    "serve": "node --import tsx src/api/serve.ts",
    "test:csharp": "vitest run --config vitest.csharp.config.ts"
  },
  "dependencies": {
    "@bootquest/shared": "0.1.0",
    "esbuild": "0.24.2",
    "express": "4.22.3",
    "ts-fsrs": "5.2.3",
    "zod": "3.25.76",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2"
  }
}
